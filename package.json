{
  "name": "lnwjud-watcher",
  "version": "0.2.0",
  "description": "Read-only LNWJUD monitoring client for Desktop/Web/PWA, Android, and iOS.",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "test:watch": "vitest",
    "desktop": "npm run build && electron .",
    "desktop:pack:windows": "npm run build && electron-builder --win portable --x64 --publish never",
    "desktop:pack:mac": "npm run build && electron-builder --mac dmg --arm64 --x64 --publish never",
    "desktop:pack:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.4.3",
    "@fontsource/prompt": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.3",
    "@capacitor/cli": "^8.4.3",
    "@capacitor/ios": "^8.4.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.lnwjud.watcher",
    "productName": "lnwjud Watcher",
    "asar": true,
    "directories": {
      "output": "release-desktop"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "public/icon-512.png",
      "public/brand/lnwjud-watcher-mark.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "lnwjud-watcher-windows-x64.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "artifactName": "lnwjud-watcher-macos-${arch}.dmg",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512.png",
      "artifactName": "lnwjud-watcher-linux-x64.AppImage",
      "category": "Utility"
    }
  }
}
